{
  "name": "ricamo",
  "version": "0.6.0",
  "description": "Offline embroidery studio, inventory and project companion",
  "author": "RuiOuteiro2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "node tests/run-browser.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never && npm run release:audit",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test:desktop": "npm run build && npm run test:desktop:smoke && npm run test:desktop:documents && npm run test:desktop:drafts && npm run test:desktop:projects && npm run test:desktop:export-cancel && npm run test:desktop:kits && npm run test:desktop:planning && npm run test:desktop:example && npm run test:desktop:data && npm run test:desktop:work && npm run test:desktop:work-empty && npm run test:desktop:materials && npm run test:desktop:attachments && npm run test:desktop:library && npm run test:desktop:stock-count && npm run test:desktop:library-details && npm run test:desktop:support && npm run test:desktop:owner-documents && npm run test:desktop:pdf-motifs && npm run test:desktop:design-size && npm run test:desktop:reference-batch && npm run test:desktop:generator-options && npm run test:desktop:catalogue-references && npm run test:desktop:label-options && npm run test:desktop:background-center && npm run test:desktop:fabric-geometry && npm run test:desktop:thread-catalogues && npm run test:desktop:revision-impact && npm run test:desktop:live-generation && npm run test:desktop:procurement && npm run test:desktop:cell-materials && npm run test:desktop:pattern-effects && npm run test:desktop:print-batches",
    "test:desktop:smoke": "node tests/desktop-smoke.mjs",
    "test:desktop:documents": "node tests/desktop-documents.mjs",
    "test:desktop:drafts": "node tests/desktop-drafts.mjs",
    "test:performance": "npm run build && node tests/performance.mjs",
    "test:performance:domain": "node tests/domain-performance.mjs",
    "icons:build": "node build/generate-icon.mjs",
    "test:desktop:projects": "node tests/desktop-projects.mjs",
    "test:desktop:export-cancel": "node tests/desktop-export-cancel.mjs",
    "test:desktop:kits": "node tests/desktop-kits.mjs",
    "test:desktop:kit-scale": "node tests/desktop-kit-scale.mjs",
    "test:desktop:example": "node tests/desktop-example.mjs",
    "test:desktop:planning": "node tests/desktop-planning.mjs",
    "test:desktop:data": "node tests/desktop-data-exports.mjs",
    "test:desktop:work": "node tests/desktop-work-companion.mjs",
    "test:desktop:work-empty": "node tests/desktop-work-empty-palette.mjs",
    "test:desktop:materials": "node tests/desktop-material-descriptors.mjs",
    "test:desktop:attachments": "node tests/desktop-attachments.mjs",
    "test:desktop:library": "node tests/desktop-pattern-library.mjs",
    "test:desktop:stock-count": "node tests/desktop-stock-count.mjs",
    "test:desktop:library-details": "node tests/desktop-library-details.mjs",
    "test:desktop:support": "node tests/desktop-support.mjs",
    "test:desktop:owner-documents": "node tests/desktop-owner-documents.mjs",
    "test:desktop:pdf-motifs": "node tests/desktop-pdf-motifs.mjs",
    "test:desktop:design-size": "node tests/desktop-design-size.mjs",
    "release:audit": "node build/release-audit.mjs",
    "test:desktop:reference-batch": "node tests/desktop-reference-batch.mjs",
    "test:desktop:generator-options": "node tests/desktop-generator-options.mjs",
    "test:desktop:catalogue-references": "node tests/desktop-catalogue-references.mjs",
    "test:desktop:label-options": "node tests/desktop-label-options.mjs",
    "test:desktop:background-center": "node tests/desktop-background-center.mjs",
    "test:desktop:fabric-geometry": "node tests/desktop-fabric-geometry.mjs",
    "test:desktop:thread-catalogues": "node tests/desktop-thread-catalogues.mjs",
    "test:desktop:revision-impact": "node tests/desktop-revision-impact.mjs",
    "test:desktop:ui": "node tests/desktop-ui-polish.mjs",
    "test:desktop:live-generation": "node tests/desktop-live-generation.mjs",
    "test:desktop:procurement": "node tests/desktop-procurement.mjs",
    "test:desktop:cell-materials": "node tests/desktop-cell-materials.mjs",
    "test:desktop:pattern-effects": "node tests/desktop-pattern-effects.mjs",
    "test:desktop:print-batches": "node tests/desktop-print-batches.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.62.0",
    "@noble/hashes": "2.4.0",
    "jspdf": "4.2.1",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "com.ruiouteiro.ricamo",
    "productName": "Ricamo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "core/**",
      "data/**",
      "src/engine/dmc.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json",
      "!node_modules/@napi-rs/canvas-linux-*/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "it_IT",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "artifactName": "Ricamo-${version}-Windows-x64-Setup.${ext}"
    },
    "copyright": "Copyright © 2026 RuiOuteiro2"
  }
}
