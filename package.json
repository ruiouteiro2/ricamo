{
  "name": "ricamo",
  "version": "0.1.0",
  "description": "Offline embroidery studio, inventory and project companion",
  "author": "RuiOuteiro2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@lucide/vue": "1.62.0",
    "jspdf": "4.2.1",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "com.ruiouteiro.ricamo",
    "productName": "Ricamo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "core/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "it_IT",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "artifactName": "Ricamo-${version}-Windows-x64-Setup.${ext}"
    }
  }
}
