{
  "name": "ricamo",
  "version": "0.1.0",
  "description": "Offline embroidery studio, inventory and project companion",
  "author": "RuiOuteiro2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "node tests/run-browser.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test:desktop": "npm run build && npm run test:desktop:smoke && npm run test:desktop:documents && npm run test:desktop:drafts && npm run test:desktop:projects && npm run test:desktop:export-cancel && npm run test:desktop:kits",
    "test:desktop:smoke": "node tests/desktop-smoke.mjs",
    "test:desktop:documents": "node tests/desktop-documents.mjs",
    "test:desktop:drafts": "node tests/desktop-drafts.mjs",
    "test:performance": "npm run build && node tests/performance.mjs",
    "test:performance:domain": "node tests/domain-performance.mjs",
    "icons:build": "node build/generate-icon.mjs",
    "test:desktop:projects": "node tests/desktop-projects.mjs",
    "test:desktop:export-cancel": "node tests/desktop-export-cancel.mjs",
    "test:desktop:kits": "node tests/desktop-kits.mjs",
    "test:desktop:kit-scale": "node tests/desktop-kit-scale.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.62.0",
    "@noble/hashes": "2.4.0",
    "jspdf": "4.2.1",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "com.ruiouteiro.ricamo",
    "productName": "Ricamo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "core/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "it_IT",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "artifactName": "Ricamo-${version}-Windows-x64-Setup.${ext}"
    },
    "copyright": "Copyright © 2026 RuiOuteiro2"
  }
}
